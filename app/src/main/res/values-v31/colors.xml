<resources>
    <!-- Android 12+: the system's colours, the same ones dynamic color and Glance use. weft_bg is the page
         (system_neutral1_10, what dynamicLightColorScheme uses for background); widget_bg is Glance's
         widgetBackground (system_accent2_50), so the loading screen matches the widget that replaces it. -->
    <color name="weft_bg">@android:color/system_neutral1_10</color>
    <color name="widget_bg">@android:color/system_accent2_50</color>
    <!-- Alarm notification buttons: the system's accent, as dynamic color's primaryContainer / primary. -->
    <color name="notification_pill">@android:color/system_accent1_100</color>
    <color name="notification_pill_text">@android:color/system_accent1_900</color>
    <color name="notification_accent">@android:color/system_accent1_600</color>
</resources>
