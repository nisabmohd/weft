<?xml version="1.0" encoding="utf-8"?>
<!-- Snooze and Dismiss in the alarm notification: text buttons, ripple only (as in Burrow). -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="@color/notification_ripple">
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <corners android:radius="20dp" />
            <solid android:color="#FFFFFFFF" />
        </shape>
    </item>
</ripple>
